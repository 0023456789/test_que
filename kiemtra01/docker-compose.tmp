  api_gateway:
    build:
      context: .
      dockerfile: api_gateway/Dockerfile
    container_name: api_gateway
    environment:
      ALLOWED_HOSTS: "*"
      CUSTOMER_SERVICE_URL: http://customer-service:8000/api
      STAFF_SERVICE_URL: http://staff-service:8000/api
      COMPUTER_SERVICE_URL: http://catalog-service:8000/api
      MOBILE_SERVICE_URL: http://catalog-service:8000/api
      TABLET_SERVICE_URL: http://tablet-service:8000/api
      MONITOR_SERVICE_URL: http://monitor-service:8000/api
      KEYBOARD_SERVICE_URL: http://keyboard-service:8000/api
      MOUSE_SERVICE_URL: http://mouse-service:8000/api
      HEADPHONE_SERVICE_URL: http://headphone-service:8000/api
      SPEAKER_SERVICE_URL: http://speaker-service:8000/api
      CAMERA_SERVICE_URL: http://camera-service:8000/api
      PRINTER_SERVICE_URL: http://printer-service:8000/api
    depends_on:
      customer_service:
        condition: service_started
      staff_service:
        condition: service_started
      catalog_service:
        condition: service_started
      tablet_service:
        condition: service_started
      monitor_service:
        condition: service_started
      keyboard_service:
        condition: service_started
      mouse_service:
        condition: service_started
      headphone_service:
        condition: service_started
      speaker_service:
        condition: service_started
      camera_service:
        condition: service_started
      printer_service:
        condition: service_started
