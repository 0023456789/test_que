      ALLOWED_HOSTS: "*"
      POSTGRES_DB: mouse_service_db
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: admin
      POSTGRES_HOST: postgres
      POSTGRES_PORT: 5432
    networks:
