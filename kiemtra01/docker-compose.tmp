  customer_service:
    build:
      context: .
      dockerfile: customer_service/Dockerfile
    container_name: customer_service
    environment:
      ALLOWED_HOSTS: "*"
      MYSQL_DATABASE: customer_service_db
      MYSQL_USER: root
      MYSQL_PASSWORD: root
      MYSQL_HOST: mysql
      MYSQL_PORT: 3306
      COMPUTER_SERVICE_URL: http://catalog-service:8000
      MOBILE_SERVICE_URL: http://catalog-service:8000
      TABLET_SERVICE_URL: http://tablet-service:8000
      MONITOR_SERVICE_URL: http://monitor-service:8000
      KEYBOARD_SERVICE_URL: http://keyboard-service:8000
      MOUSE_SERVICE_URL: http://mouse-service:8000
      HEADPHONE_SERVICE_URL: http://headphone-service:8000
      SPEAKER_SERVICE_URL: http://speaker-service:8000
      CAMERA_SERVICE_URL: http://camera-service:8000
      PRINTER_SERVICE_URL: http://printer-service:8000
    networks:
      default:
        aliases:
          - customer-service
    depends_on:
      mysql:
        condition: service_healthy
      catalog_service:
        condition: service_started
    command: sh -c "python manage.py makemigrations && python manage.py migrate && python manage.py runserver 0.0.0.0:8000"
    ports:
      - "8001:8000"

  staff_service:
    build:
      context: .
      dockerfile: staff_service/Dockerfile
    container_name: staff_service
    environment:
      ALLOWED_HOSTS: "*"
      MYSQL_DATABASE: staff_service_db
      MYSQL_USER: root
      MYSQL_PASSWORD: root
      MYSQL_HOST: mysql
      MYSQL_PORT: 3306
      COMPUTER_SERVICE_URL: http://catalog-service:8000
      MOBILE_SERVICE_URL: http://catalog-service:8000
    networks:
      default:
        aliases:
          - staff-service
    depends_on:
      mysql:
        condition: service_healthy
      catalog_service:
        condition: service_started
    command: sh -c "python manage.py makemigrations && python manage.py migrate && python manage.py runserver 0.0.0.0:8000"
