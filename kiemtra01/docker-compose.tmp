services:
  mysql:
    image: mysql:8.4
    container_name: mysql
    environment:
      MYSQL_ROOT_PASSWORD: root
    volumes:
      - mysql_data:/var/lib/mysql
      - ./docker/mysql-init:/docker-entrypoint-initdb.d:ro
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1", "-uroot", "-proot"]
      interval: 5s
      timeout: 5s
      retries: 20
      start_period: 20s

  postgres:
    image: postgres:16
    container_name: postgres
    environment:
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: admin
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./docker/postgres-init:/docker-entrypoint-initdb.d:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -h 127.0.0.1"]
      interval: 5s
      timeout: 5s
      retries: 20
      start_period: 20s

  catalog_service:
    build:
      context: .
      dockerfile: catalog_service/Dockerfile
    container_name: catalog_service
    environment:
      ALLOWED_HOSTS: "*"
      POSTGRES_DB: catalog_service_db
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: admin
      POSTGRES_HOST: postgres
      POSTGRES_PORT: 5432
    networks:
      default:
        aliases:
          - catalog-service
    depends_on:
      postgres:
        condition: service_healthy
    command: sh -c "python manage.py makemigrations && python manage.py migrate && python manage.py seed_demo_data && python manage.py runserver 0.0.0.0:8000"
    ports:
      - "8002:8000"

  tablet_service:
    build:
      context: .
      dockerfile: tablet_service/Dockerfile
    container_name: tablet_service
    environment:
      ALLOWED_HOSTS: "*"
      POSTGRES_DB: tablet_service_db
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: admin
      POSTGRES_HOST: postgres
      POSTGRES_PORT: 5432
    networks:
      default:
        aliases:
          - tablet-service
    depends_on:
      postgres:
        condition: service_healthy
    command: sh -c "python manage.py makemigrations && python manage.py migrate && python manage.py seed_demo_data && python manage.py runserver 0.0.0.0:8000"
    ports:
      - "8005:8000"

  monitor_service:
    build:
      context: .
      dockerfile: monitor_service/Dockerfile
    container_name: monitor_service
    environment:
      ALLOWED_HOSTS: "*"
      POSTGRES_DB: monitor_service_db
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: admin
