      dockerfile: printer_service/Dockerfile
    container_name: printer_service
    environment:
      ALLOWED_HOSTS: "*"
      POSTGRES_DB: printer_service_db
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: admin
